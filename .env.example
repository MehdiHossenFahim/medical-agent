# Copy this file to ".env" and fill in your real keys.

# Which LLM backend the DB tools + router agent use: "openai" or "groq"
LLM_PROVIDER=groq

# --- OpenAI (used if LLM_PROVIDER=openai, and always usable by MedicalWebSearchTool's
#     underlying libs if you go that route) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Groq (used if LLM_PROVIDER=groq) — free tier at https://console.groq.com ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b

# Required: used by MedicalWebSearchTool (https://app.tavily.com to get a free key)
TAVILY_API_KEY=tvly-...
